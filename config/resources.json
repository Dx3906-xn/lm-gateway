{
  "gateway": {
    "port": 8790,
    "host": "127.0.0.1",
    "backendPortBase": 8188,
    "portScanSpan": 64
  },
  "master": {
    "enabled": true
  },
  "gpu": {
    "totalMiB": 8188,
    "headroomMiB": 128
  },
  "resources": {
    "image": {
      "label": "生图 · Qwen-Image 2.1",
      "enabled": true,
      "exclusiveGroup": "comfy",
      "port": 8188,
      "backend": "comfy",
      "vramMiB": 5500,
      "priority": 40,
      "keepAliveSec": 180,
      "start": {
        "script": "start_comfy.ps1",
        "args": [
          "-Port",
          "{port}",
          "-ReserveVram",
          "0"
        ]
      },
      "stop": {
        "script": "stop_services.ps1",
        "args": [
          "-Service",
          "comfy"
        ]
      },
      "ready": {
        "path": "/system_stats",
        "timeoutSec": 180
      },
      "workflow": "qwen21-image-api.json",
      "outputDir": "E:\\B\\output",
      "inject": {
        "prompt": {
          "node": "4",
          "field": "prompt"
        }
      }
    },
    "anima": {
      "label": "生图 · Anima Turbo",
      "enabled": true,
      "exclusiveGroup": "comfy",
      "port": 8188,
      "backend": "comfy",
      "vramMiB": 4000,
      "priority": 45,
      "keepAliveSec": 180,
      "start": {
        "script": "start_comfy.ps1",
        "args": [
          "-Port",
          "{port}",
          "-ReserveVram",
          "0"
        ]
      },
      "stop": {
        "script": "stop_services.ps1",
        "args": [
          "-Service",
          "comfy"
        ]
      },
      "ready": {
        "path": "/system_stats",
        "timeoutSec": 180
      },
      "workflow": "anima-image-api.json",
      "outputDir": "E:\\B\\output",
      "inject": {
        "prompt": {
          "node": "4",
          "field": "text"
        }
      }
    },
    "breeze": {
      "label": "语音 · Breeze TTS 2",
      "enabled": true,
      "exclusiveGroup": "comfy",
      "port": 8188,
      "backend": "comfy",
      "vramMiB": 5400,
      "priority": 30,
      "keepAliveSec": 180,
      "start": {
        "script": "start_comfy.ps1",
        "args": [
          "-Port",
          "{port}",
          "-DisableDynamicVram"
        ]
      },
      "stop": {
        "script": "stop_services.ps1",
        "args": [
          "-Service",
          "comfy"
        ]
      },
      "ready": {
        "path": "/system_stats",
        "timeoutSec": 180
      },
      "classes": [
        "BreezeTTS2LoadModel",
        "BreezeTTS2VoiceDesign",
        "BreezeTTS2VoiceClone",
        "BreezeTTS2VoiceDirection",
        "LoadAudio",
        "SaveAudioAdvanced"
      ],
      "outputDir": "E:\\B\\output"
    },
    "tts": {
      "label": "语音 · GPT-SoVITS",
      "enabled": true,
      "exclusiveGroup": "gsv",
      "port": 8189,
      "backend": "gsv",
      "vramMiB": 5000,
      "priority": 10,
      "keepAliveSec": 300,
      "start": {
        "script": "start_gsv.ps1",
        "args": [
          "-Port",
          "{port}"
        ]
      },
      "stop": {
        "script": "stop_services.ps1",
        "args": [
          "-Service",
          "tts"
        ]
      },
      "ready": {
        "path": "/tts",
        "timeoutSec": 180,
        "method": "HEAD"
      }
    },
    "memory": {
      "label": "记忆检索 · Qwen3-Embedding-0.6B",
      "enabled": true,
      "exclusiveGroup": "embed",
      "port": 8190,
      "backend": "embed",
      "vramMiB": 1200,
      "priority": 20,
      "keepAliveSec": 120,
      "start": {
        "cmd": "E:\\B\\venv\\Scripts\\python.exe",
        "args": [
          "E:\\B\\embed-server\\serve.py"
        ],
        "env": {
          "EMBED_PORT": "{port}"
        },
        "detached": true
      },
      "stop": {
        "url": "http://127.0.0.1:{port}/shutdown",
        "waitSec": 30
      },
      "ready": {
        "path": "/health",
        "timeoutSec": 60
      }
    }
  }
}
