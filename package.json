{
  "name": "lm-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Gateway that owns the lifecycle, VRAM budget and HTTP surface of every local model service on this machine.",
  "type": "module",
  "main": "src/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-gateway.ps1",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-gateway.ps1",
    "dev": "node src/main.js",
    "status": "node src/cli.js status",
    "smoke": "node src/cli.js smoke",
    "test:injection": "node src/test-injection.js",
    "test:start": "node src/test-start.js",
    "test:memory": "node src/test-memory.js",
    "test:delivery": "node src/test-prompt-delivery.js",
    "test:resources": "node src/test-resources.js",
    "test:comfyapi": "node src/test-comfyapi.js",
    "test:crash": "node src/test-crash.js",
    "measure:image": "node src/measure-image.js"
  },
  "dependencies": {},
  "license": "MIT"
}